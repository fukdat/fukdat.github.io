# Application environment: dev | test | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Async SQLAlchemy URL.
# SQLite (local/dev):  sqlite+aiosqlite:///./billflow.db
# Postgres (prod):     postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./billflow.db

# Entropy (bytes) for generated API-key secrets.
API_KEY_SECRET_BYTES=32
